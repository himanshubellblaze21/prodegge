# ── Terraform ──────────────────────────────────────────────────────────────
**/.terraform/
**/.terraform.lock.hcl
**/terraform.tfstate
**/terraform.tfstate.backup
**/tfplan
**/backend.hcl
**/.terraform.tfstate.lock.info
# Terraform binary (downloaded locally, not committed)
terraform/terraform.exe

# Keep the packages dir (Terraform writes zips here at apply time), not the zips
terraform/packages/*.zip
!terraform/packages/
!terraform/packages/.gitkeep

# ── Lambda ──────────────────────────────────────────────────────────────────
# Dependency directories (installed locally, rebuilt at deploy time)
lambda/**/package/
# Deployment zips (generated by create_excel_package.py or Terraform)
lambda/**/*.zip

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.Python
env/
venv/
ENV/
.venv/
build/
dist/
*.egg-info/
*.egg

# ── Node / Frontend ──────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
frontend/dist/
frontend/build/

# ── IDE ──────────────────────────────────────────────────────────────────────
# Ignore .vscode settings BUT keep the template file
.vscode/*
!.vscode/template/
!.vscode/template/**
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Environment / Secrets ────────────────────────────────────────────────────
# .env is gitignored — use .env.example as the template
.env
.env.local
.env.*.local
*.pem
*.key
.aws/

# ── Logs / Temp ──────────────────────────────────────────────────────────────
*.log
logs/
tmp/
temp/
*.tmp

# Local scoring output (tests/score_local.py)
tests/output/

# Score snapshot written by tests/reprocess_all.py (contains evaluation data)
reprocess_snapshot.json

# ── Customer data — never commit ────────────────────────────────────────────
# Real customer recordings, transcripts and marked-up scorecards. Keep them on
# the machines that need them (tests/client_agreement_check.py reads
# Prodigee_new_template/), never in the repository.
sample-evaluations/
Prodigee_new_template/
