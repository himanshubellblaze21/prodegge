# ── Terraform ──────────────────────────────────────────────────────────────
**/.terraform/
**/.terraform.lock.hcl
**/terraform.tfstate
**/terraform.tfstate.backup
**/tfplan
**/backend.hcl
**/.terraform.tfstate.lock.info
# Terraform binary (downloaded locally, not committed)
terraform/terraform.exe

# Keep the packages dir (Terraform writes zips here at apply time)
!terraform/packages/
!terraform/packages/.gitkeep

# ── Lambda ──────────────────────────────────────────────────────────────────
# Dependency directories (installed locally, rebuilt at deploy time)
lambda/**/package/
# Deployment zips (generated by create_excel_package.py or Terraform)
lambda/**/*.zip

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.Python
env/
venv/
ENV/
.venv/
build/
dist/
*.egg-info/
*.egg

# ── Node / Frontend ──────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
frontend/dist/
frontend/build/

# ── IDE ──────────────────────────────────────────────────────────────────────
# Ignore .vscode settings BUT keep the template file
.vscode/*
!.vscode/template/
!.vscode/template/**
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Environment / Secrets ────────────────────────────────────────────────────
# .env is gitignored — use .env.example as the template
.env
.env.local
.env.*.local
*.pem
*.key
.aws/

# ── Logs / Temp ──────────────────────────────────────────────────────────────
*.log
logs/
tmp/
temp/
*.tmp
